// ═══════════════════════════════════════════════════════════════
// FSPEC AGENT MEMORY — Graph Queries
// ═══════════════════════════════════════════════════════════════
//
// NOTE: Edge identifiers in nanograph queries use camelCase (lowercase start),
// even though the schema declares them in PascalCase.
// Schema: "edge RelatesTo" → Query: "relatesTo"

query search_concepts($query: String) {
    match {
        $c: Concept
        match_text($c.name, $query)
    }
    return { $c.slug, $c.name, $c.category, $c.summary, $c.mentionCount, $c.confidence, $c.firstSeen, $c.lastSeen }
    order { $c.mentionCount desc }
    limit 20
}

query search_concepts_by_category($query: String, $category: String) {
    match {
        $c: Concept { category: $category }
        match_text($c.name, $query)
    }
    return { $c.slug, $c.name, $c.category, $c.summary, $c.mentionCount, $c.confidence, $c.firstSeen, $c.lastSeen }
    order { $c.mentionCount desc }
    limit 20
}

query all_concepts() {
    match { $c: Concept }
    return { $c.slug, $c.name, $c.category, $c.summary, $c.mentionCount, $c.confidence, $c.firstSeen, $c.lastSeen }
    order { $c.mentionCount desc }
    limit 50
}

query concept_neighbors($slug: String) {
    match {
        $c: Concept { slug: $slug }
        $c relatesTo $n
    }
    return { $n.slug, $n.name, $n.category, $n.summary, $n.mentionCount }
    order { $n.mentionCount desc }
    limit 20
}

query concept_related($slug: String) {
    match {
        $src: Concept { slug: $slug }
        $src relatesTo $dst
    }
    return { $dst.slug, $dst.name, $dst.category, $dst.summary, $dst.mentionCount }
    order { $dst.mentionCount desc }
    limit 20
}

query all_decisions() {
    match { $d: Decision }
    return { $d.slug, $d.title, $d.rationale, $d.status, $d.domain, $d.decidedAt, $d.createdAt }
    order { $d.decidedAt desc }
    limit 50
}

query concept_history($slug: String) {
    match {
        $c: Concept { slug: $slug }
        $t mentions $c
    }
    return { $t.slug, $t.sessionSlug, $t.turnIndex, $t.role, $t.timestamp, $t.preview }
    order { $t.timestamp desc }
    limit 20
}
