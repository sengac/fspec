{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fspec.dev/schemas/schedules.schema.json",
  "title": "Schedules",
  "description": "Schema for spec/schedules.json - SCHED-002",
  "type": "object",
  "required": ["version", "schedules"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema version for migrations"
    },
    "schedules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/scheduleEntry"
      },
      "description": "Map of schedule name to schedule entry"
    }
  },
  "definitions": {
    "scheduleEntry": {
      "type": "object",
      "required": ["name", "cron", "timezone", "jobType", "overlapPolicy", "status", "createdAt"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Unique schedule identifier (slug format: lowercase, hyphens, no spaces)"
        },
        "cron": {
          "type": "string",
          "description": "Cron expression (5-field standard syntax)"
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone string"
        },
        "jobType": {
          "type": "string",
          "enum": ["agent", "shell"],
          "description": "Job type discriminator"
        },
        "overlapPolicy": {
          "type": "string",
          "enum": ["skip", "queue"],
          "description": "What to do if previous run is still active"
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused"],
          "description": "Whether the schedule triggers"
        },
        "lastRunAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Timestamp of last completed run"
        },
        "lastRunStatus": {
          "type": ["string", "null"],
          "enum": ["completed", "failed", "skipped", null],
          "description": "Status of last run"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp (ISO8601)"
        },
        "role": {
          "type": "string",
          "description": "Agent session role (required for agent jobs)"
        },
        "prompt": {
          "type": "string",
          "description": "Initial prompt sent to agent (required for agent jobs)"
        },
        "command": {
          "type": "string",
          "description": "Shell command to execute (required for shell jobs)"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "jobType": { "const": "agent" } }
          },
          "then": {
            "required": ["role", "prompt"]
          }
        },
        {
          "if": {
            "properties": { "jobType": { "const": "shell" } }
          },
          "then": {
            "required": ["command"]
          }
        }
      ]
    }
  }
}
