+// fspec patch (BUG-643): whether each upserted row has the key of the row it
+// replaces (`before_for_updates` and `upserts` hold the rows pairwise).
+fn upserts_keep_keys(delta: &NodeDelta, key_prop: &str) -> bool {
+    let (Some(before), Some(after)) = (&delta.before_for_updates, &delta.upserts) else {
+        return false;
+    };
+    match (before.column_by_name(key_prop), after.column_by_name(key_prop)) {
+        (Some(before), Some(after)) => before.as_ref() == after.as_ref(),
+        _ => false,
+    }
+}
