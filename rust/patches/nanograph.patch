+/// fspec patch (KGRAPH-078): the portable rows (`{edge, from, to, data}`,
+/// endpoints by `@key`) of one edge type, read at the committed state
+/// `metadata` describes. Only the edge's dataset and its endpoint node
+/// types are read, so a caller can read an edge type's properties, which a
+/// traversal query cannot return, without exporting the whole graph.
+pub async fn build_edge_export_rows(
+    metadata: &DatabaseMetadata,
+    edge_type: &str,
+) -> Result<Vec<JsonValue>> {
+    let edge = metadata
+        .schema_ir()
+        .edge_types()
+        .find(|edge| edge.name == edge_type)
+        .ok_or_else(|| NanoError::Storage(format!("unknown edge type '{}'", edge_type)))?;
+    let mut keys: HashMap<String, HashMap<u64, String>> = HashMap::new();
+    for node_type in [&edge.src_type_name, &edge.dst_type_name] {
+        if keys.contains_key(node_type.as_str()) {
+            continue;
+        }
+        let node = metadata
+            .schema_ir()
+            .node_types()
+            .find(|node| &node.name == node_type)
+            .ok_or_else(|| NanoError::Storage(format!("unknown node type '{}'", node_type)))?;
+        let key_prop = node
+            .properties
+            .iter()
+            .find(|prop| prop.key)
+            .map(|prop| prop.name.as_str())
+            .ok_or_else(|| {
+                NanoError::Storage(format!("node type '{}' has no @key property", node.name))
+            })?;
+        let mut tokens = HashMap::new();
+        if let Some(batch) = read_dataset_batch(metadata.node_dataset_locator(&node.name)).await? {
+            let id_arr = batch
+                .column_by_name("id")
+                .and_then(|col| col.as_any().downcast_ref::<UInt64Array>())
+                .ok_or_else(|| {
+                    NanoError::Storage(format!(
+                        "node batch '{}' missing UInt64 id column",
+                        node.name
+                    ))
+                })?;
+            let key_idx = node_property_index(batch.schema().as_ref(), key_prop).ok_or_else(|| {
+                NanoError::Storage(format!(
+                    "node batch '{}' missing @key property '{}'",
+                    node.name, key_prop
+                ))
+            })?;
+            let key_array = batch.column(key_idx).clone();
+            for row_idx in 0..batch.num_rows() {
+                tokens.insert(
+                    id_arr.value(row_idx),
+                    export_key_token(&key_array, row_idx, key_prop)?,
+                );
+            }
+        }
+        keys.insert(node.name.clone(), tokens);
+    }
+    let mut rows = Vec::new();
+    let Some(batch) = read_dataset_batch(metadata.edge_dataset_locator(&edge.name)).await? else {
+        return Ok(rows);
+    };
+    let column = |name: &str| {
+        batch
+            .column_by_name(name)
+            .and_then(|col| col.as_any().downcast_ref::<UInt64Array>())
+            .ok_or_else(|| {
+                NanoError::Storage(format!(
+                    "edge batch '{}' missing UInt64 {} column",
+                    edge.name, name
+                ))
+            })
+    };
+    let src_arr = column("src")?;
+    let dst_arr = column("dst")?;
+    let endpoint = |node_type: &str, id: u64| {
+        keys.get(node_type)
+            .and_then(|tokens| tokens.get(&id))
+            .cloned()
+            .ok_or_else(|| {
+                NanoError::Storage(format!(
+                    "cannot export portable edge '{}': {} node {} is missing an @key token",
+                    edge.name, node_type, id
+                ))
+            })
+    };
+    for row_idx in 0..batch.num_rows() {
+        let from = endpoint(&edge.src_type_name, src_arr.value(row_idx))?;
+        let to = endpoint(&edge.dst_type_name, dst_arr.value(row_idx))?;
+        let data = export_data_map(
+            &batch,
+            row_idx,
+            &[0, 1, 2],
+            edge.properties.iter().filter_map(|prop| {
+                if is_embedding_property(prop) {
+                    Some(prop.name.as_str())
+                } else {
+                    None
+                }
+            }),
+        );
+        rows.push(serde_json::json!({
+            "edge": edge.name,
+            "from": from,
+            "to": to,
+            "data": data,
+        }));
+    }
+    Ok(rows)
+}
