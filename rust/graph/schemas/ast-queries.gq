// ═══════════════════════════════════════════════════════════════
// FSPEC AST CODE GRAPH — NanoGraph Queries v1
// ═══════════════════════════════════════════════════════════════
//
// NOTE: Edge identifiers in nanograph queries use camelCase (lowercase start),
// even though the schema declares them in PascalCase.
// Schema: "edge Contains" → Query: "contains"
//
// IMPORTANT:
// - Variables are typed via `$v: Type` or implicitly typed by edge endpoints.
// - Return clauses use `$var.prop` syntax — no field aliases, no literals.
// - For reverse traversal, bind the DESTINATION first, then the source is
//   resolved via CSC index (nanograph flips direction automatically).
// - Edge type metadata is injected by the Rust dispatch layer.

// ── Entity Listing Queries ────────────────────────────────────
// Used by AstSearch with client-side filtering.

query all_functions() {
    match { $fn: Function }
    return { $fn.slug, $fn.name, $fn.qualifiedName, $fn.isAsync, $fn.isPublic, $fn.isTest, $fn.paramCount, $fn.lineStart, $fn.lineEnd, $fn.cyclomaticComplexity, $fn.parameters, $fn.source, $fn.docstring, $fn.decorators, $fn.language, $fn.truncated }
}

query all_files() {
    match { $f: File }
    return { $f.slug, $f.path, $f.language, $f.lineCount, $f.isTest }
}

query all_types() {
    match { $t: Type }
    return { $t.slug, $t.name, $t.qualifiedName, $t.typeKind, $t.isPublic, $t.lineStart, $t.lineEnd, $t.source, $t.docstring, $t.decorators, $t.language, $t.truncated }
}

query all_dependencies() {
    match { $d: Dependency }
    return { $d.slug, $d.name, $d.version, $d.isDev, $d.source }
}

query all_variables() {
    match { $v: Variable }
    return { $v.slug, $v.name, $v.path, $v.lineStart, $v.value, $v.scope, $v.scopeName, $v.isConstant, $v.language }
}

// ── Neighbor Queries (per edge type) ──────────────────────────
// Nanograph requires typed variables and explicit edge names.
// We compose all-neighbors in Rust by calling multiple queries.

// File → Function (outgoing Contains)
query file_functions($slug: String) {
    match {
        $f: File { slug: $slug }
        $f contains $fn
    }
    return { $fn.slug, $fn.name }
}

// File → Type (outgoing ContainsType)
query file_types($slug: String) {
    match {
        $f: File { slug: $slug }
        $f containsType $t
    }
    return { $t.slug, $t.name }
}

// File → File (outgoing Imports)
query file_imports($slug: String) {
    match {
        $f: File { slug: $slug }
        $f imports $target
    }
    return { $target.slug, $target.path }
}

// File → Dependency (outgoing DependsOn)
query file_dependencies($slug: String) {
    match {
        $f: File { slug: $slug }
        $f dependsOn $dep
    }
    return { $dep.slug, $dep.name }
}

// File → Variable (outgoing ContainsVariable)
query file_variables($slug: String) {
    match {
        $f: File { slug: $slug }
        $f containsVariable $v
    }
    return { $v.slug, $v.name }
}

// Variable ← File (incoming ContainsVariable — which file contains this variable)
query variable_container($slug: String) {
    match {
        $v: Variable { slug: $slug }
        $f containsVariable $v
    }
    return { $f.slug, $f.path }
}

// Function → Function (outgoing Calls)
query function_calls($slug: String) {
    match {
        $fn: Function { slug: $slug }
        $fn calls $target
    }
    return { $target.slug, $target.name }
}

// Function ← Function (incoming Calls — who calls this function)
// Reverse traversal: bind destination ($fn) then resolve source ($caller)
query function_callers($slug: String) {
    match {
        $fn: Function { slug: $slug }
        $caller calls $fn
    }
    return { $caller.slug, $caller.name }
}

// Function → Type (outgoing TypeRef)
query function_type_refs($slug: String) {
    match {
        $fn: Function { slug: $slug }
        $fn typeRef $t
    }
    return { $t.slug, $t.name }
}

// Function ← File (incoming Contains — which file contains this function)
// Reverse traversal: bind destination ($fn) then resolve source ($f)
query function_container($slug: String) {
    match {
        $fn: Function { slug: $slug }
        $f contains $fn
    }
    return { $f.slug, $f.path }
}

// Type ← File (incoming ContainsType — which file contains this type)
query type_container($slug: String) {
    match {
        $t: Type { slug: $slug }
        $f containsType $t
    }
    return { $f.slug, $f.path }
}

// Type → Type (outgoing Implements)
query type_implements($slug: String) {
    match {
        $t: Type { slug: $slug }
        $t implements $target
    }
    return { $target.slug, $target.name }
}

// Type → Function (outgoing HasMethod: the functions defined in the
// type's body or in its impl blocks)
query type_methods($slug: String) {
    match {
        $t: Type { slug: $slug }
        $t hasMethod $fn
    }
    return { $fn.slug, $fn.name, $fn.lineStart, $fn.lineEnd, $fn.isPublic, $fn.isAsync }
}

// Type → Type (outgoing Extends)
query type_extends($slug: String) {
    match {
        $t: Type { slug: $slug }
        $t extends $parent
    }
    return { $parent.slug, $parent.name }
}

// Type ← Function (incoming TypeRef — functions referencing this type)
query type_referencing_functions($slug: String) {
    match {
        $t: Type { slug: $slug }
        $fn typeRef $t
    }
    return { $fn.slug, $fn.name }
}

// Type ← Type (incoming Extends — types that extend this type, i.e. children)
query type_extended_by($slug: String) {
    match {
        $parent: Type { slug: $slug }
        $child extends $parent
    }
    return { $child.slug, $child.name, $child.typeKind }
}

// Type ← Type (incoming Implements — types that implement this interface)
query type_implemented_by($slug: String) {
    match {
        $iface: Type { slug: $slug }
        $impl implements $iface
    }
    return { $impl.slug, $impl.name, $impl.typeKind }
}

// ── Dead Code Detection Queries ───────────────────────────────
// Uses `not { }` anti-join to find nodes with no incoming edges.

// Files with no incoming Imports edges (orphan files)
query orphan_files() {
    match {
        $f: File
        not { $other imports $f }
    }
    return { $f.slug, $f.path, $f.language, $f.lineCount, $f.isTest }
}

// Functions with no incoming Calls edges (uncalled functions)
query uncalled_functions() {
    match {
        $fn: Function
        not { $caller calls $fn }
    }
    return { $fn.slug, $fn.name, $fn.qualifiedName, $fn.isAsync, $fn.isPublic, $fn.isTest, $fn.lineStart, $fn.lineEnd, $fn.cyclomaticComplexity, $fn.parameters, $fn.source, $fn.docstring, $fn.decorators, $fn.language, $fn.truncated }
}

// Types with no incoming TypeRef edges (Extends and Implements are not
// checked: a type used only as a base or interface is listed)
query unreferenced_types() {
    match {
        $t: Type
        not { $fn typeRef $t }
    }
    return { $t.slug, $t.name, $t.qualifiedName, $t.typeKind, $t.isPublic, $t.lineStart, $t.lineEnd, $t.source, $t.docstring, $t.decorators, $t.language, $t.truncated }
}

// ── Query index (KGRAPH-077) ──────────────────────────────────
// Loaded once per graph version by GraphDatabase::query_index: every
// Calls edge, every function and type without its source text, and the
// file of every function and type. No query runs once per function.

query all_calls() {
    match {
        $caller: Function
        $caller calls $callee
    }
    return { $caller.slug as caller, $callee.slug as callee }
}

query function_index() {
    match { $fn: Function }
    return { $fn.slug, $fn.name, $fn.qualifiedName, $fn.isAsync, $fn.isPublic, $fn.isTest, $fn.paramCount, $fn.lineStart, $fn.lineEnd, $fn.cyclomaticComplexity, $fn.parameters, $fn.docstring, $fn.decorators, $fn.language, $fn.truncated }
}

query type_index() {
    match { $t: Type }
    return { $t.slug, $t.name, $t.qualifiedName, $t.typeKind, $t.isPublic, $t.lineStart, $t.lineEnd, $t.docstring, $t.decorators, $t.language, $t.truncated }
}

query all_contains() {
    match {
        $f: File
        $f contains $fn
    }
    return { $f.slug as file, $fn.slug as function }
}

query all_contains_type() {
    match {
        $f: File
        $f containsType $t
    }
    return { $f.slug as file, $t.slug as type }
}

// Source text, fetched only for the rows a response returns.
query function_source($slug: String) {
    match { $fn: Function { slug: $slug } }
    return { $fn.source }
}

query type_source($slug: String) {
    match { $t: Type { slug: $slug } }
    return { $t.source }
}

query variable_by_slug($slug: String) {
    match { $v: Variable { slug: $slug } }
    return { $v.slug }
}

// Dead code without source: the slugs of uncalled functions and of
// types without incoming TypeRef edges.
query uncalled_function_slugs() {
    match {
        $fn: Function
        not { $caller calls $fn }
    }
    return { $fn.slug }
}

query unreferenced_type_slugs() {
    match {
        $t: Type
        not { $fn typeRef $t }
    }
    return { $t.slug }
}
