# Telegram Bridge Endpoint Configuration
# Copy this to .env and fill in your values

# REQUIRED: Your bot token from BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OPTIONAL: Pre-configure chat ID (get this by messaging your bot first)
# If not set, the endpoint will learn it from the first message you send
# TELEGRAM_CHAT_ID=123456789

# OPTIONAL: WebSocket server configuration
# WEBSOCKET_PORT=8080
# WEBSOCKET_HOST=localhost

# ============================================================
# Relay Bridge Endpoint Configuration
# ============================================================

# REQUIRED: Full WebSocket URL of the relay server (including path)
# RELAY_URL=ws://relay.example.com/v1/ws

# REQUIRED: Channel ID for this fspec instance
# RELAY_CHANNEL_ID=your_channel_id_here

# REQUIRED: API key for relay authentication
# RELAY_API_KEY=your_api_key_here
