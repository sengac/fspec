# Telegram Bridge Endpoint Configuration
# Copy this to .env and fill in your values

# REQUIRED: Your bot token from BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OPTIONAL: Pre-configure chat ID (get this by messaging your bot first)
# If not set, the endpoint will learn it from the first message you send
# TELEGRAM_CHAT_ID=123456789

# OPTIONAL: WebSocket server configuration
# WEBSOCKET_PORT=8080
# WEBSOCKET_HOST=localhost
