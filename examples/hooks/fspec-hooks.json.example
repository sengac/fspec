{
  "global": {
    "timeout": 30,
    "shell": "bash -c"
  },
  "hooks": {
    "session_start": [
      {
        "name": "inject-project-standards",
        "command": "spec/hooks/on-session-start.sh",
        "timeout": 10
      }
    ],
    "session_end": [
      {
        "name": "log-session-end",
        "command": "spec/hooks/on-session-end.sh",
        "timeout": 10
      }
    ],
    "user_prompt_submit": [
      {
        "name": "policy-enforcement",
        "command": "spec/hooks/on-user-prompt.sh",
        "timeout": 5
      }
    ],
    "notification": [
      {
        "name": "log-notifications",
        "command": "spec/hooks/on-notification.sh",
        "timeout": 5
      }
    ],
    "pre_tool_use": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "spec/hooks/on-pre-tool-use.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "post_tool_use": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "command": "spec/hooks/on-post-tool-use.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
